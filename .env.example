# .env.example
# Copier ce fichier en .env (à la racine du projet) avant de lancer l'API.
# Le fichier .env réel n'est jamais mis sur GitHub (voir .gitignore) car il
# peut contenir des informations propres à chaque machine.

# Emplacement de la base de données SQLite locale (obligatoire).
DATABASE_URL=sqlite:///./data/quizzenclasse.db

# Les variables suivantes sont facultatives : des valeurs par défaut sont
# déjà prévues dans api/config.py si elles ne sont pas définies ici.
# JWT_SECRET_KEY=change-moi-en-production
# ACCESS_TOKEN_EXPIRE_MINUTES=120
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
